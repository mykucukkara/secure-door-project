# PostgreSQL Veritabanı Ayarları
POSTGRES_USER=kapi_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kapi_sistemi_db
DATABASE_URL=postgresql://kapi_user:your_secure_password_here@db:5432/kapi_sistemi_db

# Backend Sunucu Ayarları
BACKEND_PORT=3000
FRONTEND_PORT=80
NODE_ENV=development

# MQTT Broker Ayarları
MQTT_BROKER_URL=mqtt://mqtt:1883
MQTT_BROKER_HOST=mqtt
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ESP32 Cihaz Kimlik Doğrulama Anahtarı
ESP32_SECRET_KEY=your-esp32-secret-key-here

# JWT Kimlik Doğrulama Anahtarı (Web Paneli Login)
JWT_SECRET=your-jwt-secret-here

# Kapı PIN geçmişi veritabanında AES-256-GCM ile şifrelenir.
# Üretimde JWT_SECRET'tan farklı, uzun ve rastgele bir değer kullanın.
PIN_HISTORY_ENCRYPTION_KEY=replace-with-a-long-random-pin-history-key

# Kapı şifreleri varsayılan olarak KALICIDIR; kullanıcı Profil sayfasından değiştirir.
# Eski "her gece 00:00'da herkese yeni şifre" davranışı için true yapın.
PIN_OTOMATIK_YENILEME=false

# Geliştirme girişleri (üretimde güçlü ve farklı değerler kullanın)
SEED_ADMIN_EMAIL=admin@securelab.local
SEED_ADMIN_PASSWORD=change-this-development-password
SEED_ADMIN_PIN=change-this-six-digit-pin
ALLOW_DEV_PASSWORD_RESET=true
CORS_ORIGIN=http://localhost:8080
PASSWORD_RESET_BASE_URL=http://localhost:8080/sifre-sifirla.html
# Telefonların erişebileceği HTTPS alan adı veya yerel ağ adresi.
# Örnek: https://destek.example.edu.tr/ogrenci-ariza
PUBLIC_ISSUE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
APP_TIMEZONE=Europe/Istanbul

# OTA firmware dosyalarının ESP32 tarafından erişilebilen dış adresi
FIRMWARE_PUBLIC_BASE_URL=http://10.9.2.50
FIRMWARE_STORAGE_DIR=/app/firmware
OTA_SIGNING_SECRET=replace-with-a-long-random-secret
OTA_URL_TTL_SECONDS=900
